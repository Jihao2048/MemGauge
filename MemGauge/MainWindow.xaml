<Window x:Class="MemGauge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MemGauge.Controls"
        Title="内存挂件"
        Width="88" Height="88"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True" UseLayoutRounding="True">

    <!-- 背景不能是 #00xxxxxx：分层窗口在 alpha=0 的地方会把鼠标透给桌面，
         环中间的空心区域就点不到了。用 alpha=1 肉眼不可见但能接收输入。 -->
    <Grid x:Name="Root" Background="#01000000">
        <Grid.ContextMenu>
            <ContextMenu x:Name="Menu">
                <MenuItem x:Name="MenuRelease" Header="立即释放内存" Click="MenuRelease_Click" FontWeight="SemiBold" />
                <Separator />
                <MenuItem x:Name="MenuCollapse" Header="闲置时缩成细条" IsCheckable="True" Click="MenuCollapse_Click" />
                <MenuItem x:Name="MenuSnap" Header="贴边吸附" IsCheckable="True" Click="MenuSnap_Click" />
                <MenuItem x:Name="MenuTopmost" Header="始终置顶" IsCheckable="True" Click="MenuTopmost_Click" />
                <Separator />
                <MenuItem x:Name="MenuNotify" Header="释放后用系统通知" IsCheckable="True" Click="MenuNotify_Click" />
                <MenuItem x:Name="MenuFollow" Header="跟随系统外观" IsCheckable="True" Click="MenuFollow_Click" />
                <MenuItem x:Name="MenuDark" Header="深色外观" IsCheckable="True" Click="MenuDark_Click" />
                <MenuItem x:Name="MenuAutoStart" Header="开机自启" IsCheckable="True" Click="MenuAutoStart_Click" />
                <Separator />
                <MenuItem x:Name="MenuElevate" Header="以管理员身份重启" Click="MenuElevate_Click" />
                <MenuItem x:Name="MenuExit" Header="退出" Click="MenuExit_Click" />
            </ContextMenu>
        </Grid.ContextMenu>

        <Grid x:Name="RingHost" Margin="8" Cursor="Hand">
            <Grid.ToolTip>
                <ToolTip x:Name="RingTip" FontSize="12" />
            </Grid.ToolTip>
            <local:RingGauge x:Name="Gauge" Thickness="6.5" />
            <TextBlock x:Name="TxtPercent" FontSize="13" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Text="--%" />
        </Grid>

        <!-- 闲置时缩成的细条：固定长度，内部按占用率填充，渐变比例不随填充变化 -->
        <Border x:Name="Bar" Width="14" Height="88" CornerRadius="7" BorderThickness="2"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="Collapsed" Opacity="0" Cursor="Hand">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Opacity="0.3" Color="#000000" />
            </Border.Effect>
            <Grid x:Name="BarClip" ClipToBounds="True">
                <Border x:Name="BarFill" CornerRadius="6" />
            </Grid>
        </Border>
    </Grid>
</Window>
